#include <winver.h>

1 VERSIONINFO
FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_DLL
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "Lars von Thienen"
      VALUE "FileDescription", "KlarCam filter host for OBS Studio (GPL-2.0-or-later)"
      VALUE "FileVersion", "@PROJECT_VERSION@"
      VALUE "InternalName", "klarcam"
      VALUE "OriginalFilename", "klarcam.dll"
      VALUE "ProductName", "KlarCam"
      VALUE "ProductVersion", "@PROJECT_VERSION@"
      VALUE "LegalCopyright", "Copyright (C) 2026 Lars von Thienen. GNU GPL version 2 or later."
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
